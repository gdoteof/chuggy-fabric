#!/usr/bin/env python3
"""Refuse a Chuggy release whose manifests do not identify one source.

The manifests are named below as paths under `cluster/`, which is the
directory this is given: a release is the migration Job and the services that
run its images, and the two are in directories of their own."""

import re
import sys
from pathlib import Path


MIGRATION = "chuggy-migrate/chuggy-migrate.yaml"
API_MANIFESTS = (
    "chuggy/chuggy-api.yaml",
    "chuggy/chuggy-configuration-importer.yaml",
    "chuggy/chuggy-finalizer.yaml",
    MIGRATION,
    "chuggy/chuggy-pool-plane.yaml",
    "chuggy/chuggy-scheduler.yaml",
    "chuggy/chuggy-selector.yaml",
    "chuggy/chuggy-ticket-service.yaml",
    "chuggy/chuggy-worker-plane.yaml",
)
WEB_MANIFESTS = ("chuggy/chuggy-ui.yaml",)
DIGEST = r"sha256:[0-9a-f]{64}"
SOURCE_COMMIT = r"[0-9a-f]{7,40}"


# A refusal exits REFUSAL rather than 1, which is also what an uncaught
# exception here exits with. A caller that cannot tell the two apart reports a
# script it could not run as a release inconsistency.
REFUSAL = 3


def refuse(message):
    print(message, file=sys.stderr)
    raise SystemExit(REFUSAL)


def one_match(pattern, content, description):
    matches = re.findall(pattern, content, re.MULTILINE)
    if len(matches) != 1:
        refuse(f"{description}: expected one match, found {len(matches)}")
    return matches[0]


def manifest_values(path, repository):
    # Retiring or renaming a component leaves the lists above naming a file the
    # tree no longer carries, which is a fact about the release rather than a
    # script that could not run.
    if not path.is_file():
        refuse(f"the release does not carry {path}")
    content = path.read_text()
    digest = one_match(
        rf"^[ \t]*image: registry\.chuggy\.internal/chuggy/{repository}@({DIGEST})[ \t]*$",
        content,
        f"{path.name} image",
    )
    source_commit = one_match(
        rf'^[ \t]*fabric\.chuggy\.dev/source-commit: "?({SOURCE_COMMIT})"?[ \t]*$',
        content,
        f"{path.name} source commit",
    )
    return digest, source_commit


def main():
    if len(sys.argv) != 2:
        refuse("usage: check-release-consistency CLUSTER_DIRECTORY")
    directory = Path(sys.argv[1])
    api_values = [manifest_values(directory / name, "api") for name in API_MANIFESTS]
    api_digests = {digest for digest, _ in api_values}
    if len(api_digests) != 1:
        refuse("control-plane manifests do not select one API image digest")

    web_values = [manifest_values(directory / name, "web") for name in WEB_MANIFESTS]

    source_commits = {source_commit for _, source_commit in api_values}
    source_commits.update(source_commit for _, source_commit in web_values)
    if len(source_commits) != 1:
        refuse("release manifests do not identify one source commit")

    source_commit = source_commits.pop()
    migration = (directory / MIGRATION).read_text()
    migration_name = one_match(
        r"^[ \t]*name: (chuggy-migrate-[a-z0-9-]+)[ \t]*$",
        migration,
        "chuggy-migrate.yaml Job name",
    )
    expected_name = f"chuggy-migrate-{source_commit}-registry"
    if migration_name != expected_name:
        refuse(
            "migration Job identity does not match the release source commit: "
            f"expected {expected_name}, found {migration_name}"
        )


if __name__ == "__main__":
    main()
