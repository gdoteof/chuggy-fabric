#!/usr/bin/env python3
"""Refuse a Chuggy release whose manifests do not identify one source."""

import re
import sys
from pathlib import Path


API_MANIFESTS = (
    "chuggy-api.yaml",
    "chuggy-configuration-importer.yaml",
    "chuggy-finalizer.yaml",
    "chuggy-migrate.yaml",
    "chuggy-scheduler.yaml",
    "chuggy-selector.yaml",
    "chuggy-ticket-service.yaml",
    "chuggy-worker-plane.yaml",
)
WEB_MANIFEST = "chuggy-web.yaml"
DIGEST = r"sha256:[0-9a-f]{64}"
SOURCE_COMMIT = r"[0-9a-f]{7,40}"


def refuse(message):
    raise SystemExit(message)


def one_match(pattern, content, description):
    matches = re.findall(pattern, content, re.MULTILINE)
    if len(matches) != 1:
        refuse(f"{description}: expected one match, found {len(matches)}")
    return matches[0]


def manifest_values(path, repository):
    content = path.read_text()
    digest = one_match(
        rf"^[ \t]*image: registry\.chuggy\.internal/chuggy/{repository}@({DIGEST})[ \t]*$",
        content,
        f"{path.name} image",
    )
    source_commit = one_match(
        rf'^[ \t]*fabric\.chuggy\.dev/source-commit: "?({SOURCE_COMMIT})"?[ \t]*$',
        content,
        f"{path.name} source commit",
    )
    return digest, source_commit


def main():
    if len(sys.argv) != 2:
        refuse("usage: check-release-consistency APP_MANIFEST_DIRECTORY")
    directory = Path(sys.argv[1])
    api_values = [manifest_values(directory / name, "api") for name in API_MANIFESTS]
    api_digests = {digest for digest, _ in api_values}
    if len(api_digests) != 1:
        refuse("control-plane manifests do not select one API image digest")

    _, web_source_commit = manifest_values(directory / WEB_MANIFEST, "web")
    source_commits = {source_commit for _, source_commit in api_values}
    source_commits.add(web_source_commit)
    if len(source_commits) != 1:
        refuse("release manifests do not identify one source commit")

    source_commit = source_commits.pop()
    migration = (directory / "chuggy-migrate.yaml").read_text()
    migration_name = one_match(
        r"^[ \t]*name: (chuggy-migrate-[a-z0-9-]+)[ \t]*$",
        migration,
        "chuggy-migrate.yaml Job name",
    )
    expected_name = f"chuggy-migrate-{source_commit}-registry"
    if migration_name != expected_name:
        refuse(
            "migration Job identity does not match the release source commit: "
            f"expected {expected_name}, found {migration_name}"
        )


if __name__ == "__main__":
    main()
